{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@pages/*": ["src/pages/*"],
      "@layout/*": ["src/components/layout/*"],
      "@widgets/*": ["src/widgets/*"],
      "@context/*": ["src/context/*"],
      "@services/*": ["src/services/*"],
      "@data/*": ["src/data/*"],
      "@types/*": ["src/types/*"],
      "@hooks/*": ["src/hooks/*"],
      "@utils/*": ["src/utils/*"]
    },
    "ignoreDeprecations": "6.0"
  }
}
